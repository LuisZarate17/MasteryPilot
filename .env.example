# MasteryPilot configuration template.
#
# Copy this file to .env in the repository root and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit it, and never put real values in this file.


# === Django core ===

# Signs session cookies and password-reset tokens. Required whenever
# DJANGO_DEBUG is off; the app refuses to start without it.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=

# 1 for local development, 0 (or unset) for anything reachable by other people.
# Debug mode exposes tracebacks, settings, and SQL to any visitor.
# Note: with debug off, `manage.py runserver` no longer serves static files —
# set this to 1 while developing locally.
DJANGO_DEBUG=0

# Comma-separated hostnames this site answers to. Requests with any other Host
# header are rejected. Defaults to localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 1 marks session and CSRF cookies Secure and redirects HTTP to HTTPS.
# Defaults to on when DJANGO_DEBUG is off. Set to 0 only if you are serving
# plain HTTP on a trusted LAN — session cookies then travel in cleartext, and
# leaving it on without TLS breaks login entirely.
DJANGO_SECURE_COOKIES=1

# Comma-separated origins allowed to submit cross-origin POSTs, including the
# scheme, e.g. https://tutor.example.edu. Usually only needed behind a proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=


# === Initial administrator account ===
#
# Read once by migration tutor/0002 when it creates the first admin. If
# ADMIN_PASS is unset, no account is created and migrate prints a notice —
# there is no default password. Set these before the first `manage.py migrate`,
# or set them later and run migrate again.

ADMIN_USER=admin
ADMIN_EMAIL=
ADMIN_PASS=


# === Language model ===

# Required only when Gemini is enabled (settings.GEMINI_ENABLED, off by
# default). Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local model identifier used by the languagemodel_* adapters, e.g. a
# Hugging Face repo id. See docs/MODEL_SELECTOR.md.
LANGUAGE_MODEL_ID=
